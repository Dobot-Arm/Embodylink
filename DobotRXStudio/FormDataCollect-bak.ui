.QScrollArea{
	border:none;
}
.QScrollBar:vertical{
    background: #FFF;
	border-radius:6px;
    width: 12px;
	border-style:solid;
}

.QScrollBar::handle:vertical {
	background-color: #DFE3E5;
    min-height: 30px;
	border-radius:6px;
	width: 12px;
	border-style:solid;
}

.QScrollBar::sub-line:vertical,
.QScrollBar::add-line:vertical
{
    background: none;
	border:none;
    height:0px;
	width:0px;
}

.QScrollBar::up-arrow:vertical,
.QScrollBar::down-arrow:vertical{
    background: none;
    border: none;
    width: 0;
    height: 0;
}</string>
